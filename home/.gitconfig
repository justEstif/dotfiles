# Shared git settings (repo-managed via mise).
# Platform-specific ~/.gitconfig files include this file and set the identity.
# These settings override any XDG ~/.config/git/config values.

[init]
  defaultBranch = main

[pull]
  rebase = false

[push]
  default = upstream
  autoSetupRemote = true

[core]
  excludesfile = ~/.gitignore

[diff]
  algorithm = histogram
  colorMoved = plain
  mnemonicPrefix = true

[commit]
  verbose = true

[column]
  ui = auto

[branch]
  sort = -committerdate

[tag]
  sort = -version:refname

[rerere]
  enabled = true
  autoupdate = true

[alias]
  co = checkout
  br = branch
  ci = commit
  st = status
