# Consolidated git config — single source of truth (repo-managed via mise).
# Absorbed the omarchy installer's ~/.config/git/config (now removed):
# rerere, histogram diffs, sorts, column, commit.verbose, co/br/ci/st aliases.
# Precedence note: ~/.gitconfig overrides any XDG ~/.config/git/config, so if
# an omarchy reinstall ever recreates the XDG file, the values below still win.

[user]
  name = estifanos
  email = 95101485+justEstif@users.noreply.github.com

[init]
  defaultBranch = main

[pull]
  rebase = false

[push]
  default = upstream
  autoSetupRemote = true

[core]
  excludesfile = ~/.gitignore

[diff]
  algorithm = histogram
  colorMoved = plain
  mnemonicPrefix = true

[commit]
  verbose = true

[column]
  ui = auto

[branch]
  sort = -committerdate

[tag]
  sort = -version:refname

[rerere]
  enabled = true
  autoupdate = true

[alias]
  co = checkout
  br = branch
  ci = commit
  st = status
