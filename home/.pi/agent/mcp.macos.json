{
  "mcpServers": {
    "atlassian": {
      "type": "http",
      "url": "https://mcp.atlassian.com/v1/mcp/authv2"
    },
    "monarch": {
      "type": "http",
      "url": "https://mcp.monarch.cohesionapps.com/mcp"
    },
    "figma": {
      "url": "http://127.0.0.1:3845/mcp"
    },
    "next-devtools": {
      "command": "npx",
      "args": ["-y", "next-devtools-mcp@latest"]
    },
    "postman": {
      "type": "http",
      "url": "https://mcp.postman.com/mcp",
      "headers": {
        "Authorization": "${POSTMAN_MCP_TOKEN}"
      }
    },
    "rootly": {
      "url": "https://mcp.rootly.com/mcp-codemode"
    },
    "newrelic": {
      "type": "http",
      "url": "https://mcp.newrelic.com/mcp/"
    },
    "databricks-sql": {
      "type": "http",
      "url": "https://redventures-rv-spectrum-databricks-production-production-rt00zg.cloud.databricks.com/api/2.0/mcp/sql",
      "headers": {
        "Authorization": "!databricks auth token spectrum-production | jq -r '\"Bearer \" + .access_token'"
      },
      "description": "Run governed SQL queries against the Red Ventures Databricks workspace"
    }
  }
}
