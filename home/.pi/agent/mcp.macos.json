{
  "mcpServers": {
    "atlassian": {
      "type": "http",
      "url": "https://mcp.atlassian.com/v1/mcp/authv2",
      "auth": "oauth"
    },
    "figma": {
      "url": "http://127.0.0.1:3845/mcp"
    },
    "next-devtools": {
      "command": "npx",
      "args": ["-y", "next-devtools-mcp@latest"]
    },
    "chrome-devtools": {
      "command": "npx",
      "args": ["-y", "chrome-devtools-mcp@latest", "--isolated=true"]
    },
    "postman": {
      "type": "http",
      "url": "https://mcp.postman.com/mcp",
      "headers": {
        "Authorization": "${POSTMAN_MCP_TOKEN}"
      }
    },
    "echo-mcp": {
      "command": "npx",
      "args": ["--yes", "-p", "@redventures/echo@latest", "echo-mcp"]
    }
  }
}
