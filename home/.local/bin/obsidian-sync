#!/usr/bin/env bash
set -u

vault_path="${OBSIDIAN_VAULT_PATH:-$HOME/Documents/obsidian-vault}"
retry_seconds="${OBSIDIAN_SYNC_RETRY_SECONDS:-60}"
ob_bin="${OBSIDIAN_HEADLESS_BIN:-$HOME/.local/share/mise/shims/ob}"

while true; do
  if [[ ! -x "$ob_bin" ]]; then
    printf 'obsidian-sync: headless client not installed at %s\n' "$ob_bin" >&2
  elif [[ ! -d "$vault_path" ]]; then
    printf 'obsidian-sync: vault not found at %s\n' "$vault_path" >&2
  elif ! "$ob_bin" sync-status --path "$vault_path" >/dev/null 2>&1; then
    printf 'obsidian-sync: vault is not configured; run ob sync-setup --path %q --vault VAULT\n' "$vault_path" >&2
  else
    printf 'obsidian-sync: starting continuous sync for %s\n' "$vault_path"
    "$ob_bin" sync --continuous --path "$vault_path" || \
      printf 'obsidian-sync: client stopped; retrying in %ss\n' "$retry_seconds" >&2
  fi

  sleep "$retry_seconds"
done
